# Python bytecode
__pycache__/
*.py[cod]

# Packaging/build artifacts
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
.env

# Tool caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Slides: everything latexmk builds from the source
progress-slides.*
!progress-slides.tex

# Local/editor files
AGENTS.md
.idea/
.vscode/
.DS_Store

# Experiment infrastructure is tracked; generated and legacy files stay local.
/experiments/*
!/experiments/README.md
!/experiments/run.py
!/experiments/worker.slurm
!/experiments/_runner/
!/experiments/configs/
!/experiments/tests/

# Job output logs
*.err
*.out
